{
  "name": "ksu-asset-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev frontend --hostname 127.0.0.1 --port 3000",
    "build": "prisma generate --schema backend/prisma/schema.prisma && next build frontend",
    "start": "next start frontend --hostname 127.0.0.1 --port 3000",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test": "node --import tsx --test backend/tests/*.test.ts",
    "test:domain": "node --experimental-strip-types backend/tests/critical-workflows.mjs --domain-only",
    "test:integration": "node backend/tests/run-integration.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:seed:tester": "tsx backend/scripts/seed-tester.ts",
    "source:seed": "tsx backend/scripts/seed-source.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
